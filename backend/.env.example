DATABASE_URL="postgresql://shop_inventory_app:CHANGE_ME@localhost:5432/shop_inventory?schema=public"

PORT=4000
NODE_ENV=development

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Separate secrets for the super-admin portal — must differ from the ones
# above so an admin token can never verify as a tenant token, or vice versa.
ADMIN_JWT_ACCESS_SECRET=
ADMIN_JWT_REFRESH_SECRET=

CORS_ORIGIN=http://localhost:5173

# SMTP / email receipts (leave blank to disable email sending in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Shop Record <no-reply@example.com>"

# AI receipt/chat inventory assistant — backend-only, never expose to the frontend
GOOGLE_API_KEY=
