generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum OrderStatus {
  OPEN
  PAID
  VOIDED
}

enum OrderSource {
  STAFF
  CUSTOMER_QR
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum StockAdjustmentReason {
  SALE
  RESTOCK
  MANUAL_CORRECTION
  VOID_RESTOCK
}

enum ReceiptStatus {
  NOT_APPLICABLE
  PENDING
  SENT
  FAILED
}

model Tenant {
  id           String   @id @default(cuid())
  businessName String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users            User[]
  products         Product[]
  customers        Customer[]
  orders           Order[]
  stockAdjustments StockAdjustment[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ordersCreated    Order[]           @relation("OrderCreatedBy")
  ordersVoided     Order[]           @relation("OrderVoidedBy")
  payments         Payment[]
  stockAdjustments StockAdjustment[]

  @@index([tenantId])
}

model Product {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  sku               String
  name              String
  description       String?
  price             Decimal  @db.Decimal(10, 2) // vendor's true, editable price — never shown to customers
  displayPrice      Decimal  @db.Decimal(10, 2) // price + min(price x 0.5%, NGN 200), computed at create/edit time — the only price customers/staff-POS ever see
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(5)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  orderItems       OrderItem[]
  stockAdjustments StockAdjustment[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, quantity])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([tenantId])
}

model Order {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id])
  customerName String?
  status       OrderStatus @default(OPEN)
  source       OrderSource @default(STAFF)
  subtotal     Decimal     @default(0) @db.Decimal(10, 2) // sum of vendor amounts owed — internal record, not shown to vendors
  platformFee  Decimal     @default(0) @db.Decimal(10, 2) // total - subtotal — internal record, not shown to vendors
  total        Decimal     @default(0) @db.Decimal(10, 2) // sum of displayPrice x qty — the single inclusive number charged/shown to the customer

  createdById String?
  createdBy   User?  @relation("OrderCreatedBy", fields: [createdById], references: [id])

  paidAt     DateTime?
  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("OrderVoidedBy", fields: [voidedById], references: [id])
  voidReason String?

  receiptStatus ReceiptStatus @default(NOT_APPLICABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items            OrderItem[]
  payment           Payment?
  stockAdjustments StockAdjustment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, paidAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  tenantId  String
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(10, 2)

  @@index([tenantId])
  @@index([orderId])
  @@index([productId])
}

model Payment {
  id             String        @id @default(cuid())
  tenantId       String
  orderId        String        @unique
  order          Order         @relation(fields: [orderId], references: [id])
  method         PaymentMethod
  amount         Decimal       @db.Decimal(10, 2)
  markedPaidById String
  markedPaidBy   User          @relation(fields: [markedPaidById], references: [id])
  createdAt      DateTime      @default(now())

  @@index([tenantId])
}

model StockAdjustment {
  id        String                @id @default(cuid())
  tenantId  String
  tenant    Tenant                @relation(fields: [tenantId], references: [id])
  productId String
  product   Product               @relation(fields: [productId], references: [id])
  userId    String
  user      User                  @relation(fields: [userId], references: [id])
  delta     Int
  reason    StockAdjustmentReason
  orderId   String?
  order     Order?                @relation(fields: [orderId], references: [id])
  note      String?
  createdAt DateTime              @default(now())

  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, createdAt])
}
