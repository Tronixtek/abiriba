generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum OrderStatus {
  OPEN
  PAID
  VOIDED
}

enum OrderSource {
  STAFF
  CUSTOMER_QR
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  ONLINE
}

enum SettlementMode {
  INSTANT
  END_OF_DAY
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum StockAdjustmentReason {
  SALE
  RESTOCK
  MANUAL_CORRECTION
  VOID_RESTOCK
}

enum ReceiptStatus {
  NOT_APPLICABLE
  PENDING
  SENT
  FAILED
}

enum ChatRole {
  USER
  ASSISTANT
}

// Only ASSISTANT messages that parsed inventory changes carry a status other
// than NONE — plain chat replies (greetings, clarifying questions) stay NONE.
enum ProposalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

// Platform-operator identity — deliberately NOT related to Tenant. Every
// other model/query in this schema is scoped by tenantId; AdminUser is the
// one identity that can see across all tenants, so it's kept fully separate
// (own table, own JWT secret) to make that boundary impossible to blur.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Tenant {
  id           String   @id @default(cuid())
  businessName String
  slug         String   @unique // human-readable storefront URL segment, derived from businessName
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Marketplace opt-in — a vendor only appears in cross-tenant public search
  // once all of these are set. state/lga/city/street/streetNumber are the
  // vendor's typed full address (display + a no-permission-needed search
  // filter on city). latitude/longitude drive the actual distance ranking —
  // set either directly from the vendor's device GPS (most accurate), or
  // geocoded server-side from the typed address as a fallback when GPS
  // isn't shared/available.
  marketplaceEnabled Boolean   @default(false)
  country            String?   @default("Nigeria")
  state              String?
  lga                String?
  city               String?
  street             String?
  streetNumber       String?
  locationUpdatedAt  DateTime?
  latitude           Decimal?  @db.Decimal(9, 6)
  longitude          Decimal?  @db.Decimal(9, 6)

  // Where a vendor's share of online payments gets paid out to. Resolved via
  // SafeHaven name-enquiry at save time (settlementAccountName) so a typo'd
  // account number is caught immediately rather than discovered when a
  // payout later fails against a real bank.
  settlementMode          SettlementMode @default(END_OF_DAY)
  settlementBankCode      String?
  settlementAccountNumber String?
  settlementAccountName   String?

  users            User[]
  products         Product[]
  customers        Customer[]
  orders           Order[]
  stockAdjustments StockAdjustment[]
  aiChatMessages   AiChatMessage[]
  payouts          Payout[]

  @@index([marketplaceEnabled])
  @@index([city])
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String   @unique
  phone        String?
  passwordHash String
  name         String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ordersCreated       Order[]           @relation("OrderCreatedBy")
  ordersVoided        Order[]           @relation("OrderVoidedBy")
  payments            Payment[]
  stockAdjustments    StockAdjustment[]
  aiChatMessages      AiChatMessage[]
  aiProposalsReviewed AiChatMessage[]   @relation("AiProposalReviewedBy")

  @@index([tenantId])
}

model Product {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  sku               String
  name              String
  description       String?
  price             Decimal  @db.Decimal(10, 2) // vendor's true, editable price — never shown to customers
  displayPrice      Decimal  @db.Decimal(10, 2) // price + min(price x 0.5%, NGN 200), computed at create/edit time — the only price customers/staff-POS ever see
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(5)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  orderItems       OrderItem[]
  stockAdjustments StockAdjustment[]
  images           ProductImage[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, quantity])
}

model ProductImage {
  id        String   @id @default(cuid())
  tenantId  String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0) // display/swipe order — optional, capped at 3 per product at the app layer
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([productId])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([tenantId])
}

model Order {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id])
  customerName String?
  status       OrderStatus @default(OPEN)
  source       OrderSource @default(STAFF)
  subtotal     Decimal     @default(0) @db.Decimal(10, 2) // sum of vendor amounts owed — internal record, not shown to vendors
  platformFee  Decimal     @default(0) @db.Decimal(10, 2) // total - subtotal — internal record, not shown to vendors
  total        Decimal     @default(0) @db.Decimal(10, 2) // sum of displayPrice x qty — the single inclusive number charged/shown to the customer

  createdById String?
  createdBy   User?  @relation("OrderCreatedBy", fields: [createdById], references: [id])

  paidAt     DateTime?
  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("OrderVoidedBy", fields: [voidedById], references: [id])
  voidReason String?

  receiptStatus ReceiptStatus @default(NOT_APPLICABLE)

  // SafeHaven online-payment fields — all nullable, only ever set once a
  // customer starts a "pay online" attempt on a CUSTOMER_QR order. No
  // separate stored payment-status: the order just stays OPEN while awaiting
  // a transfer, same as it does today awaiting in-person payment.
  safeHavenVirtualAccountId String?
  safeHavenAccountNumber    String?
  safeHavenBankName         String?
  safeHavenPaymentReference String?   @unique
  safeHavenExpiresAt        DateTime?
  totalCharged              Decimal?  @db.Decimal(10, 2) // total grossed up for SafeHaven's own inward fee — what the customer actually transfers, always >= total

  payoutId String?
  payout   Payout? @relation(fields: [payoutId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items            OrderItem[]
  payment           Payment?
  stockAdjustments StockAdjustment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, paidAt])
  @@index([payoutId])
}

model OrderItem {
  id        String  @id @default(cuid())
  tenantId  String
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(10, 2)

  @@index([tenantId])
  @@index([orderId])
  @@index([productId])
}

model Payment {
  id             String        @id @default(cuid())
  tenantId       String
  orderId        String        @unique
  order          Order         @relation(fields: [orderId], references: [id])
  method         PaymentMethod
  amount         Decimal       @db.Decimal(10, 2)
  markedPaidById String? // null for ONLINE payments — a customer paid directly, no staff member marked it
  markedPaidBy   User?         @relation(fields: [markedPaidById], references: [id])
  createdAt      DateTime      @default(now())

  @@index([tenantId])
}

model StockAdjustment {
  id        String                @id @default(cuid())
  tenantId  String
  tenant    Tenant                @relation(fields: [tenantId], references: [id])
  productId String
  product   Product               @relation(fields: [productId], references: [id])
  userId    String? // null for SALE adjustments from an ONLINE payment — the customer paid directly, no staff actor
  user      User?                 @relation(fields: [userId], references: [id])
  delta     Int
  reason    StockAdjustmentReason
  orderId   String?
  order     Order?                @relation(fields: [orderId], references: [id])
  note      String?
  createdAt DateTime              @default(now())

  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, createdAt])
}

model AiChatMessage {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  userId   String?
  user     User?    @relation(fields: [userId], references: [id])
  role     ChatRole
  content  String
  imageUrl String?

  // Gemini's raw parsed items: [{ name, quantity, unitPrice?, matchedProductId? }].
  // Set only on assistant messages that proposed inventory changes.
  proposedActions Json?
  status          ProposalStatus @default(NONE)
  reviewedById    String?
  reviewedBy      User?          @relation("AiProposalReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model Payout {
  id       String       @id @default(cuid())
  tenantId String
  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  status   PayoutStatus @default(PENDING)

  amount Decimal @db.Decimal(10, 2) // gross vendor share, set at creation — sum of subtotal across included orders, unchanged by execution

  // Both set at execution time only. feeAmount: instant = base outward fee +
  // 7.5% VAT + flat margin; end_of_day = base outward fee only (no VAT, no
  // margin) — recorded for cost-tracking but never deducted.
  // transferredAmount: what actually left the platform account — amount
  // minus feeAmount when instant, or the unchanged full amount when
  // end-of-day (the platform absorbs feeAmount itself). Kept as its own
  // field rather than derived, since the amount-minus-fee formula only
  // applies to one of the two modes.
  feeAmount         Decimal  @default(0) @db.Decimal(10, 2)
  transferredAmount Decimal? @db.Decimal(10, 2)

  nameEnquiryReference String?
  transferReference    String? @unique
  failureReason        String?
  retryCount           Int     @default(0)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  orders Order[]

  @@index([tenantId])
  @@index([status])
}
